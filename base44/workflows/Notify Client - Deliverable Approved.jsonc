{
  "name": "Notify Client - Deliverable Approved",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Deliverable"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_client_deliverable_approved",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyDeliverableApproved",
            "args": {
              "deliverable_id": "{{entity_id}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyDeliverableApproved"
  }
}