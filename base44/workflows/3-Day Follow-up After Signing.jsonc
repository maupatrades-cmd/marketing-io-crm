{
  "name": "3-Day Follow-up After Signing",
  "description": "Send 3-day follow-up reminder to check onboarding progress",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 3,
      "interval_unit": "days",
      "interval_anchor": "2026-05-03T21:19:15.723000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "3_day_follow_up_after_signing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-followup-reminder",
            "args": {
              "days_since_signing": 3
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "send-followup-reminder"
  }
}