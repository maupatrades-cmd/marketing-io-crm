{
  "name": "Welcome Email on Contract Signed",
  "description": "Send personalized welcome email when contract status changes to signed",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"signed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Contract"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_email_on_contract_signed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-welcome-email",
            "args": {
              "contract_id": "{{ event.entity_id }}",
              "client_id": "{{ data.client_id }}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "send-welcome-email"
  }
}