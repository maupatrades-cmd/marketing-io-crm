{
  "name": "ClientNotification",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to Client \u2014 optional if recipient_user_id is set"
    },
    "recipient_user_id": {
      "type": "string",
      "description": "If set, this notification is for a specific staff/admin user. If client_id is also set, it is about that client to that user."
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "deliverable_ready",
        "invoice_issued",
        "invoice_overdue",
        "payment_received",
        "payment_failed",
        "message_received",
        "contract_to_sign",
        "report_ready",
        "onboarding_step_complete",
        "onboarding_submission",
        "lead_pending_verification",
        "client_cancelled",
        "system_update"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "related_entity_type": {
      "type": "string",
      "description": "Deal, Invoice, Deliverable, Contract, MonthlyReport, etc."
    },
    "related_entity_id": {
      "type": "string"
    },
    "action_url": {
      "type": "string",
      "description": "Link to view detail"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "notification_type",
    "title",
    "body"
  ]
}