{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "invoice_type": {
      "type": "string",
      "enum": [
        "setup_fee",
        "monthly_retainer",
        "add_on_setup",
        "add_on_monthly",
        "once_off",
        "per_sms",
        "cancellation_fee",
        "acceleration_amount",
        "addon_setup",
        "once_off_product",
        "combined",
        "monthly_subscription",
        "recurring_addon"
      ],
      "default": "monthly_retainer"
    },
    "type": {
      "type": "string",
      "enum": [
        "setup_fee",
        "addon_setup",
        "once_off_product",
        "combined",
        "monthly_subscription",
        "recurring_addon"
      ],
      "description": "PayFast-flow canonical invoice type. Mirrors invoice_type for new records."
    },
    "description": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": { "type": "string" },
          "product_name": { "type": "string" },
          "description": { "type": "string" },
          "amount": { "type": "number" },
          "quantity": { "type": "integer", "default": 1 }
        }
      }
    },
    "amount": {
      "type": "number",
      "description": "Invoice amount in ZAR"
    },
    "subtotal": {
      "type": "number"
    },
    "vat_applicable": {
      "type": "boolean",
      "default": false
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "total": {
      "type": "number",
      "description": "PayFast-flow canonical total. Mirrors total_amount for new records."
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "issued",
        "pending_payment",
        "paid",
        "overdue",
        "failed",
        "cancelled",
        "partial"
      ],
      "default": "draft"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "debit_order",
        "eft",
        "yoco",
        "payfast",
        "cash",
        "other"
      ]
    },
    "payment_id": {
      "type": "string"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "debit_run_date": {
      "type": "string",
      "format": "date"
    },
    "failed_debit_count": {
      "type": "number",
      "default": 0
    },
    "last_failed_date": {
      "type": "string",
      "format": "date"
    },
    "deal_id": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "closer_id": {
      "type": "string",
      "description": "User who closed the deal — frozen on this invoice for commission attribution"
    },
    "lead_source_user_id": {
      "type": "string",
      "description": "User who sourced the lead (CPC/field agent). May differ from closer."
    },
    "lead_source_type": {
      "type": "string",
      "enum": [
        "cpc_outbound",
        "field_direct",
        "fnc_reverse_referral",
        "self_signup",
        "partner_referral"
      ],
      "default": "self_signup"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "invoice_type",
    "amount",
    "status"
  ]
}
