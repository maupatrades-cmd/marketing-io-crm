{
  "name": "SecurityEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "account_locked",
        "password_reset_requested",
        "password_reset_completed",
        "otp_generated",
        "otp_verified_success",
        "otp_verified_failed",
        "captcha_failed",
        "suspicious_location",
        "multiple_failures",
        "account_disabled_by_owner",
        "password_force_reset_by_owner"
      ],
      "description": "Type of security event"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User"
    },
    "email": {
      "type": "string",
      "description": "Email involved in event"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address from request"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser/device user agent string"
    },
    "details": {
      "type": "string",
      "description": "JSON or freeform details about the event"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of event"
    }
  },
  "required": [
    "event_type",
    "email"
  ]
}