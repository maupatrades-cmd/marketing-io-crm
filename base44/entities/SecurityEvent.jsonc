{
  "name": "SecurityEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "account_locked",
        "password_reset_requested",
        "password_reset_completed",
        "otp_generated",
        "otp_verified_success",
        "otp_verified_failed",
        "captcha_failed",
        "suspicious_location",
        "multiple_failures",
        "account_disabled_by_owner",
        "password_force_reset_by_owner",
        "payment_completed",
        "payment_signature_mismatch",
        "payment_ip_rejected",
        "payment_postback_invalid",
        "payment_amount_mismatch",
        "payment_hash_mismatch"
      ]
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}