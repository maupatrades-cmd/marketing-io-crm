{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "field_agent",
        "cpc",
        "head_of_tech",
        "driver",
        "client"
      ],
      "default": "client"
    },
    "phone": {
      "type": "string",
      "description": "Mobile / WhatsApp number"
    },
    "password_hash": {
      "type": "string",
      "description": "bcrypt hash of user password"
    },
    "session_token": {
      "type": "string",
      "description": "Active session UUID"
    },
    "session_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the session token expires"
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "description": "True once email OTP verified"
    },
    "pending_verification": {
      "type": "boolean",
      "default": true,
      "description": "True on signup, false after OTP verified"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last successful login"
    },
    "failed_login_count": {
      "type": "number",
      "default": 0,
      "description": "Consecutive failed login attempts"
    },
    "lockout_until": {
      "type": "string",
      "format": "date-time",
      "description": "Account locked until this time"
    }
  },
  "required": []
}