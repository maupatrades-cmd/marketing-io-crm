{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "field_agent",
        "cpc",
        "head_of_tech",
        "client"
      ],
      "default": "client"
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "description": "True after email verification via signup OTP"
    },
    "email_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when email was verified"
    },
    "failed_login_count": {
      "type": "number",
      "default": 0,
      "description": "Number of failed login attempts, resets to 0 on successful login"
    },
    "account_locked": {
      "type": "boolean",
      "default": false,
      "description": "True if account is currently locked"
    },
    "account_locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "When account lockout expires"
    },
    "account_locked_reason": {
      "type": "string",
      "enum": [
        "failed_logins",
        "suspicious_activity",
        "manually_locked_by_owner",
        "security_event"
      ],
      "description": "Reason for account lockout"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last successful login"
    },
    "last_login_ip": {
      "type": "string",
      "description": "IP address of last login"
    },
    "last_login_country": {
      "type": "string",
      "description": "Country derived from last login IP"
    },
    "mfa_enabled": {
      "type": "boolean",
      "default": true,
      "description": "MFA (email OTP) required for every login"
    },
    "password_last_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when password was last changed"
    },
    "force_password_reset_required": {
      "type": "boolean",
      "default": false,
      "description": "Owner can force password reset on next login"
    }
  }
}