{
  "name": "ServiceOrder",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "requested_by_id": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "addon",
        "domain_registration",
        "business_email_setup",
        "package_upgrade"
      ]
    },
    "product_code": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "price_zar_setup": {
      "type": "number",
      "default": 0
    },
    "price_zar_recurring": {
      "type": "number",
      "default": 0
    },
    "domain_requested": {
      "type": "string"
    },
    "email_addresses_requested": {
      "type": "string"
    },
    "additional_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "under_review",
        "contract_pending",
        "approved",
        "rejected",
        "fulfilment_started",
        "completed"
      ],
      "default": "requested"
    },
    "assigned_staff_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "decline_reason": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "requested_by_id",
    "order_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.requested_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}