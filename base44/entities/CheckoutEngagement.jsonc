{
  "name": "CheckoutEngagement",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Buyer email (lowercase, trimmed) — joined back to AbandonedCartSequence and Payment by email + package_id."
    },
    "name_first": {
      "type": "string"
    },
    "name_last": {
      "type": "string"
    },
    "cell_number": {
      "type": "string",
      "description": "Normalised SA cell, 0XXXXXXXXX format."
    },
    "company_name": {
      "type": "string"
    },
    "package_id": {
      "type": "string",
      "description": "PayFast package id (e.g. 'ignite', 'ai-chatbot')."
    },
    "engagement_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the buyer last meaningfully interacted with the form."
    },
    "converted_to_payment": {
      "type": "boolean",
      "default": false,
      "description": "Flipped true when a Payment for this email + package is created via payfast-checkout-init."
    }
  },
  "required": [
    "email",
    "package_id"
  ]
}
