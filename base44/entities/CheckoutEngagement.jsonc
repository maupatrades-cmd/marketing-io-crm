{
  "name": "CheckoutEngagement",
  "properties": {
    "cell_number": {
      "description": "Normalised SA cell, 0XXXXXXXXX format.",
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "converted_to_payment": {
      "default": false,
      "description": "Flipped true when a Payment for this email + package is created via payfast-checkout-init.",
      "type": "boolean"
    },
    "email": {
      "description": "Buyer email (lowercase, trimmed) \u2014 joined back to AbandonedCartSequence and Payment by email + package_id.",
      "type": "string"
    },
    "engagement_at": {
      "description": "When the buyer last meaningfully interacted with the form.",
      "format": "date-time",
      "type": "string"
    },
    "name_first": {
      "type": "string"
    },
    "name_last": {
      "type": "string"
    },
    "package_id": {
      "description": "PayFast package id (e.g. 'ignite', 'ai-chatbot').",
      "type": "string"
    }
  },
  "required": [
    "email",
    "package_id"
  ],
  "rls": {},
  "type": "object"
}