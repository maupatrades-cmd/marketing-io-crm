{
  "name": "Lead",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "cpc_outbound",
        "field_agent_direct",
        "fnc_referral",
        "inbound",
        "referral",
        "phone_call_to_admin",
        "other"
      ],
      "default": "cpc_outbound"
    },
    "submitted_by": {
      "type": "string",
      "description": "User ID of CPC, Field Agent, or Admin who submitted"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal",
      "description": "Lead urgency flag \u2014 urgent triggers immediate owner notification"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verified",
        "rejected",
        "converted",
        "duplicate",
        "needs_clarification"
      ],
      "default": "pending_verification"
    },
    "verified_by": {
      "type": "string",
      "description": "Admin user ID who verified"
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "rejection_reason": {
      "type": "string"
    },
    "converted_to_deal_id": {
      "type": "string"
    },
    "cpc_r87_paid": {
      "type": "boolean",
      "default": false,
      "description": "R87 lead payment to CPC"
    },
    "warm_lead_criteria": {
      "type": "object",
      "description": "7 warm-lead qualification criteria (legacy v1, kept for backwards compat)",
      "properties": {
        "has_business_premises": {
          "type": "boolean",
          "default": false
        },
        "has_trading_history": {
          "type": "boolean",
          "default": false
        },
        "decision_maker_contacted": {
          "type": "boolean",
          "default": false
        },
        "expressed_interest": {
          "type": "boolean",
          "default": false
        },
        "has_budget_indication": {
          "type": "boolean",
          "default": false
        },
        "not_existing_client": {
          "type": "boolean",
          "default": false
        },
        "valid_contact_details": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "warm_lead_criteria_v2": {
      "type": "object",
      "description": "7 warm-lead qualification criteria with rich context (v2 - replaces v1)",
      "properties": {
        "has_business_premises": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "has_trading_history": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "decision_maker_contacted": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "has_budget_indication": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "expressed_interest": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "follow_up_agreed": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "permission_to_contact": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "qualification_extras": {
      "type": "object",
      "description": "Additional qualification context beyond the 7 criteria",
      "properties": {
        "monthly_revenue_band": {
          "type": "string",
          "enum": [
            "under_20k",
            "20k_50k",
            "50k_150k",
            "150k_500k",
            "500k_plus",
            "prefer_not_say"
          ]
        },
        "industry_vertical": {
          "type": "string",
          "enum": [
            "retail",
            "food_beverage",
            "beauty_salons",
            "construction",
            "professional_services",
            "health_wellness",
            "education",
            "automotive",
            "township_sme",
            "other"
          ]
        },
        "employee_band": {
          "type": "string",
          "enum": [
            "just_me",
            "2_5",
            "6_10",
            "11_25",
            "26_50",
            "50_plus"
          ]
        },
        "decision_timeline": {
          "type": "string",
          "enum": [
            "this_week",
            "this_month",
            "30_60_days",
            "just_exploring",
            "unsure"
          ]
        },
        "marketing_situation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Multi-select: no_marketing, diy_social, has_marketing_person, used_agency_before, has_website, has_logo, other"
        },
        "package_interest": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Multi-select: ignite, accelerate, dominate, street_pulse, township_pulse, addons, not_sure"
        },
        "lead_temperature": {
          "type": "string",
          "enum": [
            "cold",
            "warm",
            "hot"
          ],
          "description": "Qualifier's gut-feel rating: cold (researching), warm (interested), hot (ready to buy)"
        },
        "best_followup_time": {
          "type": "string",
          "description": "HH:MM format time when best to reach the lead"
        },
        "best_followup_days": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Days of week: Monday, Tuesday, etc."
        },
        "qualifier_notes": {
          "type": "string",
          "description": "Free-text notes from the qualifier"
        }
      }
    },
    "qualified_by": {
      "type": "string",
      "description": "User ID who completed the qualification"
    },
    "qualified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lead was qualified"
    },
    "qualification_complete": {
      "type": "boolean",
      "default": false,
      "description": "True if all 7 criteria + lead_temperature filled"
    },
    "lead_score": {
      "type": "number",
      "default": 0,
      "description": "Computed engagement + qualification score (0\u2013100)"
    },
    "score_tier": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "hot",
        "high_value"
      ],
      "default": "cold",
      "description": "Score bucket used for outreach prioritization"
    },
    "outreach_flag": {
      "type": "boolean",
      "default": false,
      "description": "Flagged for personalized outreach by sales team"
    },
    "outreach_assigned_to": {
      "type": "string",
      "description": "User ID assigned to do personalized outreach"
    },
    "outreach_notes": {
      "type": "string",
      "description": "Notes on what outreach to run for this prospect"
    },
    "last_scored_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lead score was last computed"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "contact_person",
    "phone"
  ]
}