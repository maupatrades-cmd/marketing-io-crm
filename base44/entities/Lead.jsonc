{
  "name": "Lead",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "cpc_outbound",
        "field_agent_direct",
        "fnc_referral",
        "inbound",
        "referral",
        "phone_call_to_admin",
        "other"
      ],
      "default": "cpc_outbound"
    },
    "urgency": {
      "type": "string",
      "enum": ["normal", "urgent"],
      "default": "normal",
      "description": "Set by admin to flag urgent leads for owner"
    },
    "submitted_by": {
      "type": "string",
      "description": "User ID of CPC or Field Agent who submitted"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verified",
        "rejected",
        "converted",
        "duplicate"
      ],
      "default": "pending_verification"
    },
    "verified_by": {
      "type": "string",
      "description": "Admin user ID who verified"
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "rejection_reason": {
      "type": "string"
    },
    "converted_to_deal_id": {
      "type": "string"
    },
    "cpc_r87_paid": {
      "type": "boolean",
      "default": false,
      "description": "R87 lead payment to CPC"
    },
    "warm_lead_criteria": {
      "type": "object",
      "description": "7 warm-lead qualification criteria",
      "properties": {
        "has_business_premises": {
          "type": "boolean",
          "default": false
        },
        "has_trading_history": {
          "type": "boolean",
          "default": false
        },
        "decision_maker_contacted": {
          "type": "boolean",
          "default": false
        },
        "expressed_interest": {
          "type": "boolean",
          "default": false
        },
        "has_budget_indication": {
          "type": "boolean",
          "default": false
        },
        "not_existing_client": {
          "type": "boolean",
          "default": false
        },
        "valid_contact_details": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "lead_score": {
      "type": "number",
      "default": 0,
      "description": "Computed engagement + qualification score (0\u2013100)"
    },
    "score_tier": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "hot",
        "high_value"
      ],
      "default": "cold",
      "description": "Score bucket used for outreach prioritization"
    },
    "outreach_flag": {
      "type": "boolean",
      "default": false,
      "description": "Flagged for personalized outreach by sales team"
    },
    "outreach_assigned_to": {
      "type": "string",
      "description": "User ID assigned to do personalized outreach"
    },
    "outreach_notes": {
      "type": "string",
      "description": "Notes on what outreach to run for this prospect"
    },
    "last_scored_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lead score was last computed"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "contact_person",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "owner" } },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "field_agent" } },
        { "user_condition": { "role": "cpc" } }
      ]
    },
    "read": {
      "$or": [
        { "data.assigned_field_agent": "{{user.id}}" },
        { "data.cpc_id": "{{user.id}}" },
        { "data.created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "owner" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "owner" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "owner" }
    }
  }
}