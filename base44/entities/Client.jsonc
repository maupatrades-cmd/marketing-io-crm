{
  "name": "Client",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Client business name"
    },
    "contact_person": {
      "type": "string",
      "description": "Primary contact full name"
    },
    "email": {
      "type": "string",
      "description": "Business email address"
    },
    "phone": {
      "type": "string",
      "description": "WhatsApp / mobile number"
    },
    "id_reg_number": {
      "type": "string",
      "description": "ID number or CIPC registration number"
    },
    "address": {
      "type": "string",
      "description": "Physical business address"
    },
    "industry": {
      "type": "string",
      "enum": [
        "retail",
        "services",
        "construction",
        "hospitality",
        "beauty",
        "health",
        "professional",
        "education",
        "other"
      ],
      "description": "Business industry / sector"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "prospect",
        "onboarding",
        "active",
        "suspended",
        "cancelled",
        "churned"
      ],
      "default": "lead"
    },
    "package": {
      "type": "string",
      "enum": [
        "ignite",
        "accelerate",
        "dominate",
        "street_pulse",
        "township_pulse",
        "none"
      ],
      "default": "none"
    },
    "setup_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "setup_fee_amount": {
      "type": "number",
      "description": "Setup fee amount in ZAR"
    },
    "monthly_retainer": {
      "type": "number",
      "description": "Monthly retainer amount in ZAR"
    },
    "debit_order_date": {
      "type": "string",
      "enum": [
        "1st",
        "15th"
      ],
      "description": "Debit order date"
    },
    "go_live_date": {
      "type": "string",
      "format": "date"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date"
    },
    "failed_debits_count": {
      "type": "number",
      "default": 0,
      "description": "Number of failed debits in rolling 12 months"
    },
    "acceleration_triggered": {
      "type": "boolean",
      "default": false,
      "description": "True if 3 failed debits triggered acceleration clause"
    },
    "onboarding_form_returned": {
      "type": "boolean",
      "default": false
    },
    "debit_mandate_signed": {
      "type": "boolean",
      "default": false
    },
    "brand_assets_received": {
      "type": "boolean",
      "default": false
    },
    "go_live_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "assigned_field_agent": {
      "type": "string",
      "description": "User ID of assigned Field Agent"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "source": {
      "type": "string",
      "enum": [
        "cpc_outbound",
        "field_agent_direct",
        "fnc_referral",
        "inbound",
        "referral",
        "other"
      ],
      "description": "Lead source path"
    },
    "client_user_id": {
      "type": "string",
      "description": "Reference to User \u2014 links to their portal login"
    },
    "portal_invitation_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When portal access was invited"
    },
    "first_portal_login_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of first portal login"
    },
    "portal_last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last portal activity timestamp"
    },
    "preferred_communication_channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "phone",
        "sms"
      ],
      "default": "email",
      "description": "Preferred way to contact this client"
    },
    "notification_preferences": {
      "type": "string",
      "description": "JSON object with notification settings (email_deliverable_ready, email_invoice_issued, etc.)"
    },
    "logo_file": {
      "type": "string",
      "description": "URL of client's uploaded business logo"
    },
    "hero_image_url": {
      "type": "string",
      "description": "Cached portal hero image URL (24h TTL)"
    },
    "hero_image_copy": {
      "type": "string",
      "description": "Cached emotional headline paired with the hero image"
    },
    "hero_image_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cached hero image was generated"
    },
    "hero_image_scenario": {
      "type": "string",
      "description": "Scenario pool name used to generate the cached hero image"
    },
    "years_in_business": {
      "type": "string",
      "enum": ["starting", "less_than_1", "1_to_3", "3_to_5", "5_to_10", "10_plus"]
    },
    "number_of_employees": {
      "type": "string",
      "enum": ["just_me", "2_to_5", "6_to_15", "16_to_50", "50_plus"]
    },
    "business_city": {
      "type": "string",
      "description": "City the business operates in"
    },
    "business_address": {
      "type": "string",
      "description": "Full physical address (signup step 2)"
    },
    "business_province": {
      "type": "string",
      "enum": [
        "gauteng",
        "western_cape",
        "kwazulu_natal",
        "eastern_cape",
        "free_state",
        "limpopo",
        "mpumalanga",
        "north_west",
        "northern_cape"
      ]
    },
    "monthly_revenue_range": {
      "type": "string",
      "enum": ["under_20k", "20k_to_50k", "50k_to_150k", "150k_to_500k", "500k_plus"]
    },
    "twelve_month_goal": {
      "type": "string",
      "enum": ["same_steady", "double_revenue", "five_x_growth", "sell_business", "open_branches"]
    },
    "biggest_challenge": {
      "type": "string",
      "enum": [
        "not_enough_leads",
        "customers_dont_return",
        "cant_compete",
        "dont_know_marketing",
        "too_busy_doing_work",
        "bad_reputation",
        "all_above"
      ]
    },
    "new_customers_target": {
      "type": "string",
      "enum": ["5_to_10", "10_to_25", "25_to_50", "50_to_100", "100_plus"]
    },
    "monthly_marketing_budget": {
      "type": "string",
      "enum": ["under_500", "500_to_1500", "1500_to_3000", "3000_to_7000", "7000_plus"]
    },
    "current_marketing_assets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Multi-select of assets the client already has (website, whatsapp_automation, active_social, gmb_claimed, paid_ads, email_marketing, crm)"
    },
    "agency_history": {
      "type": "string",
      "enum": ["yes_didnt_work", "yes_too_expensive", "never", "tried_diy"]
    },
    "urgency_level": {
      "type": "string",
      "enum": ["yesterday", "within_1_month", "within_3_months", "planning_ahead", "no_rush"]
    },
    "founder_inspiration": {
      "type": "string",
      "description": "Free-form: what inspired the founder"
    },
    "competitor_envy": {
      "type": "string",
      "description": "Free-form: what a competitor is doing the founder wishes they were"
    },
    "preferred_contact_channels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Multi-select: phone, whatsapp, email, sms"
    },
    "best_call_time": {
      "type": "string",
      "enum": ["morning", "lunch", "afternoon", "evening", "weekend_only"]
    },
    "wants_consultation_call": {
      "type": "boolean",
      "default": false
    },
    "wants_personalized_proposal": {
      "type": "boolean",
      "default": false
    },
    "lead_score": {
      "type": "string",
      "enum": ["hot", "warm", "nurture", "cold", "unqualified"],
      "description": "Calculated lead score from signup answers"
    },
    "lead_score_calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "signup_completed_steps": {
      "type": "number",
      "default": 1,
      "description": "How many of the 5 signup steps the lead completed"
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": ["lead", "qualified", "active", "churned", "disqualified"],
      "default": "lead",
      "description": "Sales lifecycle stage. New self-signups land as 'lead'; owner promotes to 'qualified' on allocation."
    },
    "lead_source_type": {
      "type": "string",
      "enum": [
        "cpc_outbound",
        "field_direct",
        "fnc_reverse_referral",
        "self_signup",
        "partner_referral"
      ],
      "default": "self_signup",
      "description": "How the lead arrived. self_signup is the portal registration default."
    },
    "app_user_id": {
      "type": "string",
      "description": "AppUser.id of the signed-up user. Mirrors client_user_id for the canonical commission/lead-routing field set."
    },
    "assigned_consultant_id": {
      "type": "string",
      "description": "User.id of the field agent / CPC currently allocated to this client. NULL until owner allocates from /owner/leads."
    }
  },
  "required": [
    "business_name",
    "contact_person",
    "email"
  ]
}