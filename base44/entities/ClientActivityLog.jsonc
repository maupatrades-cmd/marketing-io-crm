{
  "name": "ClientActivityLog",
  "type": "object",
  "properties": {
    "client_id": { "type": "string" },
    "client_name": { "type": "string" },
    "user_id": {
      "type": "string",
      "description": "AppUser.id of recipient — same as client.client_user_id usually"
    },
    "title": {
      "type": "string",
      "description": "Short heading e.g. 'Invoice issued' or 'Welcome to Marketing iO'"
    },
    "body": {
      "type": "string",
      "description": "1-2 sentence detail"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name e.g. 'FileText', 'CheckCircle', 'AlertCircle'"
    },
    "category": {
      "type": "string",
      "enum": ["info", "success", "warning", "error"],
      "default": "info"
    },
    "source": {
      "type": "string",
      "enum": [
        "signup",
        "enquiry",
        "invoice",
        "payment",
        "deliverable",
        "contract",
        "onboarding",
        "cancellation",
        "system"
      ],
      "description": "Which subsystem wrote this entry"
    },
    "link": {
      "type": "string",
      "description": "Optional /client/* route to deep-link from the activity item"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Null until client opens activity feed"
    },
    "event_type": {
      "type": "string",
      "enum": ["status_change", "milestone", "note", "task_completed"],
      "default": "note",
      "description": "Legacy field — new portal-feed entries default to 'note'."
    },
    "event_label": {
      "type": "string",
      "description": "Legacy short description. Mirrored from `title` for new portal entries."
    },
    "from_value": { "type": "string" },
    "to_value": { "type": "string" },
    "logged_by": { "type": "string" },
    "logged_by_name": { "type": "string" }
  },
  "required": ["client_id", "title"]
}
