{
  "name": "LoginAttempt",
  "type": "object",
  "properties": {
    "email_attempted": {
      "type": "string"
    },
    "success": {
      "type": "boolean",
      "default": false
    },
    "failure_reason": {
      "type": "string",
      "enum": [
        "wrong_password",
        "account_not_found",
        "account_locked",
        "captcha_failed",
        "otp_failed",
        "account_disabled",
        "other"
      ]
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "attempted_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "email_attempted",
    "success"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}