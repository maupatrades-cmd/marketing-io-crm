{
  "name": "Payment",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string",
      "description": "Linked invoice — populated after successful payment confirmation. NULL for pending payments still awaiting ITN."
    },
    "amount": { "type": "number" },
    "currency": { "type": "string", "default": "ZAR" },
    "type": {
      "type": "string",
      "enum": ["setup_fee", "addon_setup", "once_off_product", "combined", "monthly_subscription", "recurring_addon"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "successful", "failed", "cancelled", "refunded"],
      "default": "pending"
    },
    "gateway": {
      "type": "string",
      "enum": ["payfast", "ozow", "manual"],
      "default": "payfast"
    },
    "gateway_reference": { "type": "string", "description": "Our internal m_payment_id (UUID)" },
    "gateway_pf_payment_id": { "type": "string" },
    "gateway_payment_status": { "type": "string" },
    "ipn_payload": { "type": "object" },
    "failed_reason": { "type": "string" },
    "completed_at": { "type": "string", "format": "date-time" },
    "closer_id": {
      "type": "string",
      "description": "Snapshot from invoice — frozen at payment-create time for commission attribution"
    },
    "lead_source_user_id": {
      "type": "string",
      "description": "Snapshot from invoice — lead sourcer for CPC closure bonus attribution"
    },
    "commission_calculated": {
      "type": "boolean",
      "default": false,
      "description": "Idempotency flag for calculate-commission"
    },
    "package_id": {
      "type": "string",
      "description": "Slug of the PayFast package the buyer selected at checkout (e.g. 'ignite', 'ai-chatbot'). Mirrors custom_str1 on the PayFast payload."
    },
    "signed_payload_hash": {
      "type": "string",
      "description": "Hash of the signed PayFast field set at checkout-init time, used by the ITN handler to detect tampering or mismatched payloads. "
    }
  },
  "required": ["client_id", "amount", "type", "status", "gateway_reference"]
}
